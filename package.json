{
  "name": "tagreeve",
  "version": "0.5.0-rc.1",
  "description": "Agent-first testing for website tracking and consent.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alfhen/tagreeve.git"
  },
  "bugs": {
    "url": "https://github.com/alfhen/tagreeve/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@10.34.7",
  "bin": {
    "tagreeve": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && ASTRO_TELEMETRY_DISABLED=1 astro sync --root site && tsc --noEmit -p site/tsconfig.json",
    "test": "vitest run --project unit",
    "e2e": "vitest run --project e2e",
    "docs:build": "ASTRO_TELEMETRY_DISABLED=1 astro build --root site && node scripts/check-docs-dist.ts site/dist",
    "docs:test": "vitest run --project docs",
    "docs:preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview --root site",
    "fixture": "node fixtures/site/src/serve.ts"
  },
  "dependencies": {
    "@duckduckgo/autoconsent": "16.51.0",
    "@faker-js/faker": "10.6.0",
    "node-forge": "1.4.0",
    "playwright": "1.64.1",
    "tldts": "7.4.18",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@astrojs/markdown-satteri": "0.4.4",
    "@astrojs/preact": "6.1.0",
    "@astrojs/starlight": "0.42.6",
    "@fontsource/anton": "5.3.0",
    "@fontsource/geist": "5.3.0",
    "@fontsource/geist-mono": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.5",
    "@types/node-forge": "1.3.14",
    "@vitest/browser-preview": "5.0.4",
    "astro": "7.4.0",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "mermaid": "11.17.2",
    "preact": "11.0.1",
    "satteri": "0.10.5",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  }
}
