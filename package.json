{
  "name": "pingwright",
  "version": "0.2.0",
  "description": "Agent-first testing for website tracking and consent.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alfhen/pingwright.git"
  },
  "bugs": {
    "url": "https://github.com/alfhen/pingwright/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@10.34.7",
  "bin": {
    "pingwright": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "e2e": "vitest run --project e2e",
    "docs:build": "vitepress build && node scripts/check-docs-dist.ts .vitepress/dist",
    "docs:test": "vitest run --project docs",
    "docs:preview": "vitepress preview",
    "fixture": "node fixtures/site/src/serve.ts"
  },
  "dependencies": {
    "@duckduckgo/autoconsent": "16.51.0",
    "@faker-js/faker": "10.6.0",
    "playwright": "1.64.1",
    "tldts": "7.4.18",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@fontsource/jost": "5.3.0",
    "@types/node": "22.20.5",
    "@vitest/browser-preview": "5.0.4",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "mermaid": "11.17.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitepress": "2.0.0-alpha.20",
    "vitest": "5.0.4",
    "vue": "3.5.44"
  }
}
