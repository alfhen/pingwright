{
  "name": "pingwright",
  "version": "0.0.0",
  "description": "Agent-first testing for website tracking and consent.",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=22.18" },
  "packageManager": "pnpm@10.34.7",
  "bin": { "pingwright": "dist/cli.js" },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "node scripts/build.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "e2e": "vitest run --project e2e",
    "fixture": "node fixtures/site/src/serve.ts"
  },
  "dependencies": {
    "@duckduckgo/autoconsent": "16.51.0",
    "@faker-js/faker": "10.6.0",
    "playwright": "1.64.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@vitest/browser-preview": "5.0.4",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  }
}
