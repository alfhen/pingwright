---
import Mark from './Mark.astro';

const repo = 'https://github.com/alfhen/tagreeve';
const nav = [
  { label: 'Docs', href: '/docs/guide/what-it-checks' },
  { label: 'CLI reference', href: '/docs/cli' },
];
const buttonBase = 'cursor-pointer rounded-md border border-rule bg-transparent font-mono font-medium leading-[normal]';
---

<div class="site-header mx-auto box-content flex h-14 max-w-[1280px] items-center leading-[normal] gap-[26px] px-7 max-[520px]:gap-3 max-[520px]:px-4">
  <a href="/" class="flex shrink-0 items-center gap-[9px] text-fg hover:no-underline">
    <Mark />
    <span class="font-mono text-base leading-[normal] font-semibold tracking-[-0.02em]">tagreeve</span>
  </a>
  <nav aria-label="Main" class="hidden flex-1 gap-5 text-sm leading-[normal] min-[860px]:flex">
    {nav.map((item) => <a href={item.href} class="text-dim hover:text-fg">{item.label}</a>)}
  </nav>
  <button
    type="button"
    data-menu-toggle
    aria-label="Menu"
    aria-expanded="false"
    aria-controls="site-menu"
    class:list={[buttonBase, 'ml-auto px-2.5 py-[5px] text-sm text-fg min-[860px]:hidden']}
  >☰</button>
  <button type="button" data-theme-toggle class:list={[buttonBase, 'shrink-0 px-[9px] py-1.5 text-xs text-dim [font-variant-emoji:text]']}>
    <span class="when-dark">☀ light</span><span class="when-light">☾ dark</span>
  </button>
  <div class="flex shrink-0 items-center gap-2 max-[520px]:hidden">
    <a href={repo} class="rounded-md border border-rule px-2.5 py-1.5 font-mono text-[13px] font-medium text-fg">github ↗</a>
    <a href={`${repo}/stargazers`} class="font-mono text-[13px] font-medium text-mint">(★ star us)</a>
  </div>
</div>
<nav
  id="site-menu"
  aria-label="Menu"
  hidden
  class="absolute inset-x-0 top-14 flex-col border-t border-b border-rule bg-void px-7 pt-1.5 pb-3.5 text-base leading-[normal] [&:not([hidden])]:flex"
>
  {nav.map((item) => <a href={item.href} class="border-b border-rule py-2.5 text-fg">{item.label}</a>)}
  <a href={repo} class="border-b border-rule py-2.5 text-fg min-[521px]:hidden">github ↗</a>
  <a href={`${repo}/stargazers`} class="py-2.5 text-mint min-[521px]:hidden">(★ star us)</a>
</nav>

<script>
  import '../scripts/header.ts';
</script>
