---
import { INSTALL_COMMAND, PROMPT } from '../../lib/prompt.ts';
---

<section class="mx-auto box-content flex max-w-[1280px] flex-col items-center gap-4 px-7 pt-10 pb-6 text-center">
  <span class="flex items-center gap-2 rounded-full border border-rule px-3 py-[5px] font-mono text-xs font-medium text-dim">
    <span class="size-1.5 rounded-full bg-mint"></span>0.4 release candidate · Chromium · MIT
  </span>
  <h1 class="m-0 max-w-[1000px] text-[clamp(40px,5.4vw,76px)] leading-[0.95] font-semibold tracking-[-0.05em] text-balance">
    "Should only take 5 minutes." <span class="text-mint">Now it does.</span>
  </h1>
  <p class="m-0 max-w-[640px] text-[19px] leading-normal text-pretty text-dim">
    Tagreeve plays a visitor in a real browser, catches every tracking request, decodes it and checks it against your rules. Ask an agent Mads's question below, and watch it answer in under a minute.
  </p>
  <div class="flex flex-wrap justify-center gap-2.5">
    <button
      type="button"
      data-copy-from="hero-prompt"
      data-copied-label="Copied. Paste into your agent"
      data-copied-ms="2200"
      class="cursor-pointer rounded-lg border-0 bg-mint px-[18px] py-[13px] text-[15px] font-semibold text-onmint"
    >Copy the agent setup prompt</button>
    <button
      type="button"
      data-copy-text={INSTALL_COMMAND}
      data-copied-label="✓ copied"
      data-copied-ms="2200"
      class="cursor-pointer rounded-lg border border-rule bg-panel px-4 py-3 font-mono text-sm font-medium text-fg"
    >$ {INSTALL_COMMAND}</button>
  </div>
  <details class="hero-prompt group flex w-full max-w-[760px] flex-col items-center">
    <summary class="mx-auto w-max cursor-pointer list-none font-mono text-xs font-medium text-dim underline underline-offset-[3px] [&::-webkit-details-marker]:hidden">
      <span class="group-open:hidden">what does the prompt say?</span><span class="hidden group-open:inline">hide the prompt</span>
    </summary>
    <pre
      id="hero-prompt"
      class="mt-4 mb-0 box-border max-h-[300px] w-full overflow-auto rounded-xl border border-rule bg-code px-[18px] py-4 text-left font-mono text-xs leading-[1.65] whitespace-pre-wrap text-code-ink">{PROMPT}</pre>
  </details>
</section>

<script>
  import '../../scripts/copy-prompt.ts';
</script>
